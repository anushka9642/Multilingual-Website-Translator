# ==========================================
# Multilingual Website Translator - Environment Config
# ==========================================

# Database Caching Configuration (SQL Server - Optional)
# The application functions seamlessly without a database;
# caching is bypassed if SQL Server is not reachable.
DB_SERVER=localhost
DB_NAME=MultilingualTranslatorDB
# DB_USER=your_username
# DB_PASSWORD=your_password

# API Security Key
# Required for single & batch translation API endpoints
API_KEY=your_secure_api_key_here

# CORS Allowed Origins (Comma-separated list of browser origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
